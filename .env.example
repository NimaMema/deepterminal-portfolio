# Copy to .env (never commit .env). All variables are optional unless noted.

# Data: "demo" serves five fictional, labelled companies; "live" uses SEC EDGAR.
DEEPTERMINAL_DATA_MODE=demo
# Required by SEC fair-access policy in live mode: "Your Name your.email@example.com"
DEEPTERMINAL_SEC_USER_AGENT=
# Replay cached SEC responses only (no network)
DEEPTERMINAL_OFFLINE=false
DEEPTERMINAL_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/deepterminal

# ── Zero-cost policy ─────────────────────────────────────────────────────────
# DEEPTERMINAL needs no paid service. Requests go only to free public sources and your own
# machine; any other host is refused (deepterminal/costpolicy.py). Leave this false.
DEEPTERMINAL_ALLOW_PAID_APIS=false

# ── AI: local open-weight models via Ollama (free) ──────────────────────────
# auto = Ollama if running with the model below, otherwise rule-based (no generated prose).
# auto | ollama | rules | anthropic | openai   (anthropic/openai need ALLOW_PAID_APIS=true)
DEEPTERMINAL_LLM_PROVIDER=auto
DEEPTERMINAL_OLLAMA_URL=http://127.0.0.1:11434
# Any Ollama model with tool calling, e.g. qwen2.5:7b-instruct (Apache-2.0), llama3.1:8b, mistral-nemo
DEEPTERMINAL_OLLAMA_MODEL=qwen2.5:7b-instruct
DEEPTERMINAL_LLM_MAX_OUTPUT_TOKENS=4000
DEEPTERMINAL_LLM_MAX_TOOL_CALLS=12
DEEPTERMINAL_LLM_MAX_INPUT_TOKENS_PER_JOB=400000

# ── Free market and macro data ──────────────────────────────────────────────
# stooq (free end-of-day CSV, non-commercial use, attribution) | none
DEEPTERMINAL_PRICE_PROVIDER=stooq
# Only if Stooq starts asking for its free key
DEEPTERMINAL_STOOQ_APIKEY=
# FRED macro series use the keyless CSV endpoint: nothing to configure.

# ── Optional paid providers: OFF unless you opt in above ────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPTERMINAL_ANTHROPIC_MODEL=claude-opus-5-5
# DEEPTERMINAL_OPENAI_MODEL=gpt-5
# Daily cap on paid-API tokens (local Ollama tokens are free and not counted)
DEEPTERMINAL_LLM_DAILY_TOKEN_BUDGET=2000000

# API protection
# If set, the API requires "Authorization: Bearer <token>". The web server adds it to proxied
# /api requests (frontend/middleware.ts), so set the same value for the web process.
DEEPTERMINAL_API_TOKEN=
DEEPTERMINAL_RATE_LIMIT_PER_MINUTE=240
DEEPTERMINAL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PDF export: path to a Chromium binary if Playwright's bundled one is not installed
DEEPTERMINAL_CHROMIUM_EXECUTABLE=

# Optional note shown on the Data sources screen (e.g. a network egress restriction)
DEEPTERMINAL_NETWORK_NOTE=
